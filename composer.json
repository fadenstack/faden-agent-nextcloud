{
  "name": "fadenstack/faden-agent-nextcloud",
  "description": "A governed Nextcloud file assistant",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Fadenstack",
      "homepage": "https://fadenstack.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "OCA\\FadenstackAgent\\": "lib/"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "test:unit": "phpunit -c tests/phpunit.xml"
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "nextcloud/ocp": "dev-stable35",
    "nextcloud/coding-standard": "^1.3",
    "phpunit/phpunit": "^10.5"
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true,
    "optimize-autoloader": true
  }
}

# ESLint and the tests expect LF: check out every text file with LF, on Windows too.
* text=auto eol=lf
# Match the PHP formatter on Windows and Linux checkouts.
*.php text eol=lf
# Shell scripts and the files the development containers mount run on Linux: LF on every checkout.
*.sh text eol=lf
dev/** text eol=lf
*.pdf binary
